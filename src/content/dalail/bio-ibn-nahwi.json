  "lines": [
    {
      "id": "bio-ibn-nahwi-l0001",
      "ar": "سدى ابن النحوى",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0002",
      "ar": "‏هذه القصد نظم أبى الفضل بوسف",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0003",
      "ar": "النحو 2( العالم العامل الصوق صاحت",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0004",
      "ar": "‏أَلدَّعْوَة أَلْمُجَابَة . أَخَلَ عن الْامَامَْن للخم",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0005",
      "ar": "والمازري . وهو توزري فيرَوَانِ . دخل",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0006",
      "ar": "وكاس . من اجل الدراسة . كان سئن",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0007",
      "ar": "ألسَكّف الصَّالح . حَاضًا مَءَ ألله فى غَالب",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0008",
      "ar": "أمْره . وَكَانَ لَهُ أَعْتنَاءٌ نَاةّ بكتّاب إخّْاء",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0009",
      "ar": "علوم الدين لالبى حامد الغزالى . وقصيدته",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0010",
      "ar": "هَاته قَدَ عنىَ النَّاسَ كثيرًا بحفظها وَشَرْحَهَا",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0011",
      "ar": "يجبس ري : لكنها تررق ررعب",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0012",
      "ar": "مُنْفَرجَةُ أبن ألنّخوي مِنّ الإقبَال وَالْقَبُولِ",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0013",
      "ar": "عنْدَ ألْعَامَة وَألْخَاصَّة . وَقَدَ أَعْتَنَى بشَّدْحهًا",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0014",
      "ar": "ابوه العم النقا شم حك ‎١‏",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0015",
      "ar": "‏بو العبّاس التقاوسي وَسَمَى شر نوار",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0016",
      "ar": "بشرح القصددة المنفرحة فى اخر حناته",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0017",
      "ar": "أَنْقَطَعَ فيهًا إلى أللّه . وَبهَا ثُوُفّْ سَنَةَ ‎١١١‏",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0018",
      "ar": "الله وَرَضيَ عنه.",
      "kind": "prose"
    },
    {
      "id": "bio-ibn-nahwi-l0019",
      "ar": "هجرية . رحمه ورصي",
      "kind": "prose"
    }
  ]
}